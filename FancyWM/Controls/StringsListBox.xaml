<UserControl x:Class="FancyWM.Controls.StringsListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FancyWM.Controls"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             d:DataContext="{d:DesignInstance Type=local:StringsListBox}"
             xmlns:res="clr-namespace:FancyWM.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Text, Mode=OneTime}" LostFocus="TextBox_LostFocus" />
                <Button Grid.Column="1"
                        Margin="6,0,0,0"
                        Style="{DynamicResource MacOsPillButtonStyle}"
                        MinHeight="30"
                        Padding="10,0"
                        Click="Button_Click"
                        ToolTip="删除">
                    <ui:FontIcon VerticalAlignment="Center" FontSize="13" FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" Foreground="{DynamicResource LiquidGlassDestructiveBrush}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Margin="0,0,0,6">
            <ui:SimpleStackPanel Spacing="8" Orientation="Horizontal">
                <Button Style="{DynamicResource MacOsPrimaryButtonStyle}" MinHeight="30" Padding="14,0" Click="OnAddClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon VerticalAlignment="Center" FontSize="12" FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" Foreground="White" />
                        <TextBlock Margin="7,0,0,0" Text="{x:Static res:Strings.AddNew}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource MacOsPillButtonStyle}" MinHeight="30" Padding="14,0" Click="OnClearAllClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon VerticalAlignment="Center" FontSize="12" FontFamily="Segoe MDL2 Assets" Glyph="&#xE894;" Foreground="{DynamicResource LiquidGlassSecondaryFg}" />
                        <TextBlock Margin="7,0,0,0" Text="{x:Static res:Strings.ClearAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ui:SimpleStackPanel>
        </Border>
        <StackPanel Margin="0,4,0,-4" x:Name="ItemsBox" />
    </DockPanel>
</UserControl>
