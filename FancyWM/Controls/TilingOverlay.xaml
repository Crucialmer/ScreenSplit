<UserControl x:Class="FancyWM.Controls.TilingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FancyWM.Controls"
             xmlns:util="clr-namespace:FancyWM.Utilities"
             xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:TilingOverlayViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Canvas>
        <!-- Pure Screen Split: Header panel bars and popup window menu bars are disabled -->
        <ItemsControl ItemsSource="{Binding Path=PanelElements}" Visibility="Collapsed" />
        <ItemsControl ItemsSource="{Binding Path=WindowElements}" Visibility="Collapsed" />
    </Canvas>
</UserControl>
