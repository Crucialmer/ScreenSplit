<UserControl x:Class="FancyWM.Pages.Settings.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FancyWM.Pages.Settings"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:FancyWM.Controls"
             xmlns:res="clr-namespace:FancyWM.Resources"
             xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="900"/>
        </Grid.ColumnDefinitions>
        <ui:SimpleStackPanel Margin="0,0,0,32" Spacing="16">
            <!-- Hero Header -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,18"
                    Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#007AFF" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#007AFF" />
                        </Border.Effect>
                        <Image Source="/Resources/Icon.ico" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ScreenSplit 便携分屏使用指南" FontWeight="SemiBold" FontSize="18" Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" />
                        <TextBlock Text="极简 · 高效 · 纯绿色运行 · 无任何干扰性菜单栏" FontSize="12.5" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts Card Section -->
            <TextBlock Text="常用分屏快捷键" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="2,12,0,4" />
            <Border Style="{DynamicResource SettingsItemStyle}">
                <ui:SimpleStackPanel Spacing="12">
                    <!-- Shift + Win hint -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="激活前缀组合键" FontWeight="Medium" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="7,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Margin="0,0,4,0">
                                <TextBlock Text="Shift" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="2,0" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="7,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                <TextBlock Text="⊞ Win" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Rectangle Height="1" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.3" />

                    <!-- H -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="水平切分（左右平铺当前窗口）" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="8,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="H" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>

                    <!-- V -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="垂直切分（上下平铺当前窗口）" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="8,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="V" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>

                    <!-- S -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="堆叠切分（标签页堆叠模式）" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="8,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="S" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>

                    <!-- F -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="切换浮动模式 / 平铺模式" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="8,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="F" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>

                    <!-- F11 -->
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="全局暂停 / 恢复平铺管理" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="5" Padding="8,3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" HorizontalAlignment="Right">
                            <TextBlock Text="F11" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </DockPanel>
                </ui:SimpleStackPanel>
            </Border>

            <!-- Mouse Gestures -->
            <TextBlock Text="鼠标自适应操作" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="2,12,0,4" />
            <Border Style="{DynamicResource SettingsItemStyle}">
                <ui:SimpleStackPanel Spacing="8">
                    <TextBlock Text="• 拖拽分屏接缝：将鼠标悬停在各分屏区域之间的边框缝隙处，按住左键拖拽即可自由缩放各窗口的显示比例。" TextWrapping="Wrap" />
                    <TextBlock Text="• 智能自适应平铺：窗口关闭后，邻近窗口会自动均分剩余空间；新窗口打开时根据当前规则自动加入平铺布局。" TextWrapping="Wrap" />
                </ui:SimpleStackPanel>
            </Border>

            <!-- Green Storage -->
            <TextBlock Text="纯绿色存储规范" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="2,12,0,4" />
            <Border Style="{DynamicResource SettingsItemStyle}">
                <ui:SimpleStackPanel Spacing="6">
                    <TextBlock Text="ScreenSplit 贯彻 100% 绿色便携设计原则：" FontWeight="Medium" />
                    <TextBlock Text="所有配置数据（Settings.json）与运行日志全部存放在程序所在目录的 Data/ 文件夹内，系统注册表零写入、不残留任何临时文件，随时拷入 U 盘即可在不同电脑即开即用。" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                </ui:SimpleStackPanel>
            </Border>
        </ui:SimpleStackPanel>
    </Grid>
</UserControl>
