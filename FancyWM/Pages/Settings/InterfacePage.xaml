<UserControl x:Class="FancyWM.Pages.Settings.InterfacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
             xmlns:res="clr-namespace:FancyWM.Resources"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="820" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Margin="0,0,0,24">
            <TextBlock Text="{x:Static res:Strings.Interface_Caption}" Style="{DynamicResource MacPageTitleStyle}" />

            <!-- Sizes Group -->
            <TextBlock Text="{x:Static res:Strings.Interface_Sizes}" Style="{DynamicResource MacSectionHeaderStyle}" />
            <Border Style="{DynamicResource MacGroupedCardStyle}">
                <DockPanel LastChildFill="True" Margin="18,14">
                    <Border DockPanel.Dock="Right"
                            Background="{DynamicResource LiquidGlassAccentTintBg}"
                            BorderBrush="{DynamicResource LiquidGlassAccentTintBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,3"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                        <TextBlock Typography.NumeralAlignment="Tabular"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource LiquidGlassAccentBrush}"
                                   Text="{Binding Value, ElementName=WindowPaddingSlider, StringFormat={}{0:0} px}" />
                    </Border>
                    <Slider DockPanel.Dock="Right"
                            x:Name="WindowPaddingSlider"
                            VerticalAlignment="Center"
                            Maximum="32"
                            Minimum="0"
                            IsSnapToTickEnabled="True"
                            TickFrequency="2"
                            Value="{Binding WindowPadding, Mode=TwoWay}"
                            Width="190" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{x:Static res:Strings.Interface_WindowPadding}" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                        <TextBlock Text="调整分屏窗口间的视觉呼吸间距（像素）" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Colors Group -->
            <TextBlock Text="{x:Static res:Strings.Interface_Colors}" Style="{DynamicResource MacSectionHeaderStyle}" />
            <Border Style="{DynamicResource MacGroupedCardStyle}">
                <StackPanel Orientation="Vertical">
                    <DockPanel LastChildFill="True" Margin="18,13">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Path=OverrideAccentColor, Mode=TwoWay}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{x:Static res:Strings.Interface_OverrideAccentColor}" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                            <TextBlock Text="自定义边缘停靠预览液态玻璃强调色调" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Rectangle Style="{DynamicResource MacHairlineDividerStyle}" />

                    <StackPanel Orientation="Vertical" Margin="18,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock VerticalAlignment="Center" Text="R" FontWeight="SemiBold" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Width="18" />
                            <TextBox Text="{Binding Path=CustomAccentColorR, Mode=TwoWay}" Width="86" Margin="0,0,14,0" />
                            <TextBlock VerticalAlignment="Center" Text="G" FontWeight="SemiBold" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Width="18" />
                            <TextBox Text="{Binding Path=CustomAccentColorG, Mode=TwoWay}" Width="86" Margin="0,0,14,0" />
                            <TextBlock VerticalAlignment="Center" Text="B" FontWeight="SemiBold" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Width="18" />
                            <TextBox Text="{Binding Path=CustomAccentColorB, Mode=TwoWay}" Width="86" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="A" FontWeight="SemiBold" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Width="18" />
                            <TextBox Text="{Binding Path=CustomAccentColorA, Mode=TwoWay}" Width="86" Margin="0,0,14,0" />
                            <Border Width="34" Height="34"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource LiquidGlassCardBorder}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Path=CustomAccentColor}" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="实时色彩预览" FontSize="12" Foreground="{DynamicResource LiquidGlassSecondaryFg}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
