<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=netstandard">
    <sys:Double x:Key="ControlCornerRadiusPx">10</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">10,10,10,10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLeft">10,0,10,0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusTop">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusRight">0,10,0,10</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusBottom">0,0,10,10</CornerRadius>
    <sys:Double x:Key="OverlayCornerRadiusPx">14</sys:Double>
    <CornerRadius x:Key="OverlayCornerRadius">14,14,14,14</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusLeft">14,0,14,0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusTop">14,14,0,0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusRight">0,14,0,14</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusBottom">0,0,14,14</CornerRadius>
</ResourceDictionary>
