<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <sys:Double x:Key="ControlCornerRadiusPx">14</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">14,14,14,14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLeft">14,0,0,14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusTop">14,14,0,0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusRight">0,14,14,0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusBottom">0,0,14,14</CornerRadius>
    <sys:Double x:Key="OverlayCornerRadiusPx">18</sys:Double>
    <CornerRadius x:Key="OverlayCornerRadius">18,18,18,18</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusLeft">18,0,0,18</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusTop">18,18,0,0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusRight">0,18,18,0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadiusBottom">0,0,18,18</CornerRadius>
</ResourceDictionary>
