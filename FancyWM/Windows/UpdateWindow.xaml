<Window x:Class="FancyWM.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:FancyWM.Windows"
        mc:Ignorable="d"
        Title="ScreenSplit 软件更新"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="540"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif"
        Foreground="{DynamicResource LiquidGlassPrimaryFg}"
        ui:ThemeManager.IsThemeAware="True"
        MouseLeftButtonDown="OnWindowMouseDown">

    <!-- macOS 26 Liquid Glass Floating Update Sheet -->
    <Border x:Name="SheetContainer"
            Margin="26"
            CornerRadius="22"
            Background="{DynamicResource LiquidGlassWindowBg}"
            BorderBrush="{DynamicResource LiquidGlassWindowBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SheetTranslate" Y="12" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" Direction="270" ShadowDepth="10" Opacity="0.36" Color="#000000" />
        </Border.Effect>

        <Grid>
            <!-- Top Liquid Glass Specular Refraction Sheen -->
            <Border CornerRadius="21,21,10,10"
                    VerticalAlignment="Top"
                    Height="48"
                    Margin="0.5,0.5,0.5,0"
                    Background="{DynamicResource LiquidGlassTopSheen}"
                    IsHitTestVisible="False" />

            <DockPanel LastChildFill="True">
                <!-- macOS 26 Window Title Bar with Group-Hover Traffic Lights -->
                <Border DockPanel.Dock="Top"
                        Height="44"
                        Padding="18,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource LiquidGlassSeparator}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid>
                        <StackPanel x:Name="TrafficLightsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Background="Transparent">
                            <!-- Red (Close) -->
                            <Button Click="OnCloseButtonClick"
                                    Width="12" Height="12"
                                    Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="关闭">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" Width="12" Height="12" CornerRadius="6" Background="#FF5F56" BorderBrush="#D9453E" BorderThickness="0.5">
                                            <TextBlock x:Name="Glyph" Text="×" FontSize="9.5" FontWeight="Bold" Foreground="#5A0000" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter TargetName="Dot" Property="Background" Value="#488E8E93" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#308E8E93" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TrafficLightsPanel}" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="#FF5F56" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#D9453E" />
                                                <Setter TargetName="Glyph" Property="Opacity" Value="0.88" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Yellow (Minimize) -->
                            <Button Click="OnMinimizeButtonClick"
                                    Width="12" Height="12"
                                    Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="最小化">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#D99B1C" BorderThickness="0.5">
                                            <TextBlock x:Name="Glyph" Text="−" FontSize="9.5" FontWeight="Bold" Foreground="#5C3B00" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter TargetName="Dot" Property="Background" Value="#488E8E93" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#308E8E93" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TrafficLightsPanel}" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="#FFBD2E" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#D99B1C" />
                                                <Setter TargetName="Glyph" Property="Opacity" Value="0.88" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Green (Disabled in fixed sheet) -->
                            <Border Width="12" Height="12" CornerRadius="6" Background="#488E8E93" BorderBrush="#308E8E93" BorderThickness="0.5" />
                        </StackPanel>

                        <TextBlock Text="ScreenSplit 软件更新"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <StackPanel Margin="24,18,24,22" Orientation="Vertical">
                    <!-- Hero App Identity Glass Card -->
                    <Border Background="{DynamicResource LiquidGlassCardBg}"
                            BorderBrush="{DynamicResource LiquidGlassCardBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16,13"
                            Margin="0,0,0,18">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    Width="48" Height="48"
                                    CornerRadius="12"
                                    Margin="0,0,14,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.24" Color="#000000" />
                                </Border.Effect>
                                <Image x:Name="AppHeroIcon" Width="48" Height="48" Stretch="Uniform" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ScreenSplit"
                                               FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                                               FontWeight="SemiBold"
                                               FontSize="17.5"
                                               Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <Border x:Name="StatusBadge"
                                            Background="{DynamicResource LiquidGlassAccentTintBg}"
                                            BorderBrush="{DynamicResource LiquidGlassAccentTintBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,1.5"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusBadgeText"
                                                   Text="检查中"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LiquidGlassAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="纯绿色便携 · 边缘智能吸附分屏 · 240Hz 超流畅"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                           Margin="0,3.5,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 1. Checking View -->
                    <Grid x:Name="CheckingView" Height="138" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="26" Foreground="{DynamicResource LiquidGlassAccentBrush}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                                <ui:FontIcon.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                </ui:FontIcon.RenderTransform>
                                <ui:FontIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </ui:FontIcon.Triggers>
                            </ui:FontIcon>
                            <Border CornerRadius="3" Height="5" Width="220" Background="{DynamicResource LiquidGlassProgressTrack}" ClipToBounds="True" Margin="0,14,0,10">
                                <ProgressBar Height="5" IsIndeterminate="True" Foreground="{DynamicResource LiquidGlassAccentBrush}" Background="Transparent" BorderThickness="0" />
                            </Border>
                            <TextBlock Text="正在连接更新服务器并检索最新发布版本..."
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,3" />
                            <TextBlock x:Name="CheckingSubtext"
                                       Text="正在比对本地版本与 GitHub Release 发行通道"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 2. Up To Date View -->
                    <StackPanel x:Name="UpToDateView" Visibility="Collapsed" Margin="0,4,0,0">
                        <Border Width="50" Height="50"
                                CornerRadius="25"
                                Background="#1E30D158"
                                BorderBrush="#4530D158"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                         Glyph="&#xE73E;"
                                         FontSize="22"
                                         Foreground="{DynamicResource LiquidGlassEmeraldBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="当前已是最新版本"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock x:Name="UpToDateDescription"
                                   Text="ScreenSplit 目前已是最新状态。"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                   LineHeight="18.5" />
                        <TextBlock x:Name="LastCheckedText"
                                   Text="上次检查时间: 刚刚"
                                   FontSize="11"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource LiquidGlassTertiaryFg}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,18" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                    Content="好"
                                    Width="104"
                                    Margin="0,0,10,0"
                                    Click="OnCloseButtonClick" />
                            <Button Style="{StaticResource MacOsPillButtonStyle}"
                                    Content="重新下载当前完整包"
                                    ToolTip="体验完整下载与热替换更新流程"
                                    Click="OnForceReDownloadClick" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Update Available View -->
                    <StackPanel x:Name="UpdateAvailableView" Visibility="Collapsed" Margin="0,2,0,0">
                        <DockPanel LastChildFill="True" Margin="2,0,2,10">
                            <TextBlock x:Name="NewVersionTitle"
                                       Text="发现新版本 ScreenSplit"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NewVersionMeta"
                                       Text="大小: ~8.8 MB"
                                       FontSize="11.5"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- macOS 26 Recessed Glass Release Notes Box -->
                        <Border CornerRadius="14"
                                Background="{DynamicResource LiquidGlassRecessedBg}"
                                BorderBrush="{DynamicResource LiquidGlassCardBorder}"
                                BorderThickness="1"
                                Padding="14,11"
                                MaxHeight="168">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MacThinScrollBar}" />
                                </ScrollViewer.Resources>
                                <TextBlock x:Name="ReleaseNotesText"
                                           Text="版本更新说明..."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18.5"
                                           Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                            </ScrollViewer>
                        </Border>

                        <!-- Action Row -->
                        <DockPanel LastChildFill="False" Margin="0,18,0,0">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource MacOsPillButtonStyle}"
                                    Content="暂不更新"
                                    Click="OnCloseButtonClick" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource MacOsPillButtonStyle}"
                                        Content="在浏览器中查看"
                                        Margin="0,0,8,0"
                                        Click="OnViewInBrowserClick" />
                                <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                        Content="立即下载并更新"
                                        Click="OnStartDownloadClick" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- 4. Downloading View -->
                    <StackPanel x:Name="DownloadingView" Visibility="Collapsed" Margin="0,4,0,0">
                        <DockPanel LastChildFill="True" Margin="2,0,2,8">
                            <TextBlock Text="正在下载更新包..."
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DownloadPercentText"
                                       Text="0%"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource LiquidGlassAccentBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Style="{StaticResource MacProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,0,0,10" />

                        <TextBlock x:Name="DownloadStatusDetail"
                                   Text="已下载: 0.0 MB / 8.8 MB  •  速度: 0.0 MB/s"
                                   FontSize="11.5"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                   Margin="2,0,2,18" />

                        <Button Style="{StaticResource MacOsPillButtonStyle}"
                                Content="取消下载"
                                HorizontalAlignment="Right"
                                Click="OnCancelDownloadClick" />
                    </StackPanel>

                    <!-- 5. Ready To Restart View -->
                    <StackPanel x:Name="ReadyToRestartView" Visibility="Collapsed" Margin="0,4,0,0">
                        <Border Width="50" Height="50"
                                CornerRadius="25"
                                Background="#1E30D158"
                                BorderBrush="#4530D158"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                         Glyph="&#xE73E;"
                                         FontSize="22"
                                         Foreground="{DynamicResource LiquidGlassEmeraldBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="更新包已下载完成"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock Text="ScreenSplit 更新文件已就绪。&#x0a;点击「立即重启」即可瞬间完成升级并自动重新运行。&#x0a;您的所有个性化设置与便携数据均完好保留。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                   LineHeight="18.5"
                                   Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource MacOsEmeraldButtonStyle}"
                                    Content="立即重启并完成更新"
                                    Margin="0,0,10,0"
                                    Click="OnRestartAndInstallClick" />
                            <Button Style="{StaticResource MacOsPillButtonStyle}"
                                    Content="稍后手动重启"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 6. Error View -->
                    <StackPanel x:Name="ErrorView" Visibility="Collapsed" Margin="0,4,0,0">
                        <Border Width="50" Height="50"
                                CornerRadius="25"
                                Background="#1EF59E0B"
                                BorderBrush="#45F59E0B"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                         Glyph="&#xE7BA;"
                                         FontSize="22"
                                         Foreground="#F59E0B"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="检查更新失败"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LiquidGlassPrimaryFg}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4" />
                        <TextBlock Text="无法连接到更新服务器，请检查网络连接后重试。"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}" />
                        <TextBlock x:Name="ErrorMessageText"
                                   Text="网络连接超时"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource LiquidGlassTertiaryFg}"
                                   Margin="0,6,0,18" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                    Content="重试"
                                    Width="100"
                                    Margin="0,0,10,0"
                                    Click="OnRetryClick" />
                            <Button Style="{StaticResource MacOsPillButtonStyle}"
                                    Content="好"
                                    Width="82"
                                    Click="OnCloseButtonClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
