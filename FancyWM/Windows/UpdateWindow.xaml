<Window x:Class="FancyWM.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:FancyWM.Windows"
        mc:Ignorable="d"
        Title="ScreenSplit 软件更新"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="530"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif"
        Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
        ui:ThemeManager.IsThemeAware="True"
        MouseLeftButtonDown="OnWindowMouseDown">

    <Window.Resources>
        <!-- macOS Pill Button Style -->
        <Style x:Key="MacOsPillButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlPageTextBaseHighBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Primary Blue Pill Button Style -->
        <Style x:Key="MacOsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MacOsPillButtonStyle}">
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3" Color="#007AFF" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS Emerald Green Primary Pill Button Style -->
        <Style x:Key="MacOsEmeraldButtonStyle" TargetType="Button" BasedOn="{StaticResource MacOsPillButtonStyle}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3" Color="#10B981" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- macOS Soft Shadow Container -->
    <Border Margin="24"
            CornerRadius="20"
            Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="12" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <!-- macOS Window Title Bar with Traffic Light Controls -->
            <Border DockPanel.Dock="Top"
                    Height="42"
                    Padding="16,0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="20,20,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <!-- macOS Traffic Light Window Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Red (Close) -->
                        <Button Click="OnCloseButtonClick"
                                Width="12" Height="12"
                                Padding="0" Margin="0,0,8,0"
                                Cursor="Hand"
                                Background="#FF5F56"
                                BorderThickness="0"
                                ToolTip="关闭">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#E0443E" BorderThickness="0.5">
                                        <ui:FontIcon x:Name="CloseIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="7" Foreground="#4D0000" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseIcon" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Yellow (Minimize) -->
                        <Button Click="OnMinimizeButtonClick"
                                Width="12" Height="12"
                                Padding="0" Margin="0,0,8,0"
                                Cursor="Hand"
                                Background="#FFBD2E"
                                BorderThickness="0"
                                ToolTip="最小化">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#DEA123" BorderThickness="0.5">
                                        <ui:FontIcon x:Name="MinIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE738;" FontSize="7" Foreground="#5A3A00" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MinIcon" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Green (Disabled/Placeholder) -->
                        <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.5" />
                    </StackPanel>

                    <!-- Title Centered in macOS Style -->
                    <TextBlock Text="ScreenSplit 软件更新"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <StackPanel Margin="24,18,24,20" Orientation="Vertical">
                <!-- Hero App Identity Header -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <!-- App Icon Squircle with Shadow -->
                        <Border DockPanel.Dock="Left"
                                Width="48" Height="48"
                                CornerRadius="12"
                                Background="Transparent"
                                Margin="0,0,14,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#007AFF" />
                            </Border.Effect>
                            <Image x:Name="AppHeroIcon" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ScreenSplit" FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" />
                                <!-- Dynamic Status Badge -->
                                <Border x:Name="StatusBadge"
                                        Background="#15007AFF"
                                        BorderBrush="#35007AFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,1.5"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusBadgeText"
                                               Text="检查中"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#007AFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="纯绿色便携 · 边缘智能吸附分屏 · 240Hz超流畅"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 1. Checking View -->
                <Grid x:Name="CheckingView" Height="140" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="28" Foreground="#007AFF" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                            <ui:FontIcon.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                            </ui:FontIcon.RenderTransform>
                            <ui:FontIcon.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ui:FontIcon.Triggers>
                        </ui:FontIcon>
                        <ProgressBar Width="240" Height="3.5" IsIndeterminate="True" Foreground="#007AFF" Margin="0,14,0,8" />
                        <TextBlock Text="正在连接更新服务器并检索最新发布版本..."
                                   FontSize="13"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,3" />
                        <TextBlock x:Name="CheckingSubtext"
                                   Text="正在比对本地版本与 GitHub Release 发行通道"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 2. Up To Date View -->
                <StackPanel x:Name="UpToDateView" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#1810B981"
                            BorderBrush="#3510B981"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                     Glyph="&#xE73E;"
                                     FontSize="22"
                                     Foreground="#10B981"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="当前已是最新版本"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4" />
                    <TextBlock Text="ScreenSplit 目前已是最新状态。&#x0a;所有智能边缘吸附与多尺寸记忆特性均已就绪。"
                               x:Name="UpToDateDescription"
                               FontSize="12"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               LineHeight="18" />
                    <TextBlock x:Name="LastCheckedText"
                               Text="上次检查时间: 刚刚"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,16" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                Content="好"
                                Width="110"
                                Margin="0,0,10,0"
                                Click="OnCloseButtonClick" />
                        <Button Style="{StaticResource MacOsPillButtonStyle}"
                                Content="重新下载当前完整包"
                                ToolTip="体验完整下载与更新流程"
                                Click="OnForceReDownloadClick" />
                    </StackPanel>
                </StackPanel>

                <!-- 3. Update Available View -->
                <StackPanel x:Name="UpdateAvailableView" Visibility="Collapsed" Margin="0,2,0,0">
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <TextBlock x:Name="NewVersionTitle"
                                   Text="发现新版本 ScreenSplit v2.19.2"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="NewVersionMeta"
                                   Text="大小: ~8.8 MB"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- macOS Recessed Release Notes Box -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            Padding="14,10"
                            MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReleaseNotesText"
                                       Text="版本更新说明..."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}" />
                        </ScrollViewer>
                    </Border>

                    <!-- Buttons Row -->
                    <DockPanel LastChildFill="False" Margin="0,16,0,0">
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource MacOsPillButtonStyle}"
                                Content="暂不更新"
                                Click="OnCloseButtonClick" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MacOsPillButtonStyle}"
                                    Content="在浏览器中查看"
                                    Margin="0,0,8,0"
                                    Click="OnViewInBrowserClick" />
                            <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                    Content="立即下载并更新"
                                    Padding="18,0"
                                    Click="OnStartDownloadClick" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- 4. Downloading View -->
                <StackPanel x:Name="DownloadingView" Visibility="Collapsed" Margin="0,6,0,0">
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock Text="正在下载更新包..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DownloadPercentText"
                                   Text="0%"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#007AFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Progress Bar with rounded track -->
                    <Border CornerRadius="4"
                            Height="8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            ClipToBounds="True"
                            Margin="0,0,0,8">
                        <ProgressBar x:Name="DownloadProgressBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     BorderThickness="0"
                                     Foreground="#007AFF"
                                     Background="Transparent" />
                    </Border>

                    <TextBlock x:Name="DownloadStatusDetail"
                               Text="已下载: 0.0 MB / 8.8 MB  •  速度: 0.0 MB/s"
                               FontSize="11.5"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               Margin="0,0,0,16" />

                    <!-- Cancel Button -->
                    <Button Style="{StaticResource MacOsPillButtonStyle}"
                            Content="取消下载"
                            HorizontalAlignment="Right"
                            Click="OnCancelDownloadClick" />
                </StackPanel>

                <!-- 5. Ready To Restart View -->
                <StackPanel x:Name="ReadyToRestartView" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#1810B981"
                            BorderBrush="#3510B981"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                     Glyph="&#xE73E;"
                                     FontSize="22"
                                     Foreground="#10B981"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="更新包已下载完成！"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4" />
                    <TextBlock Text="ScreenSplit 更新文件已就绪。&#x0a;点击「立即重启」即可瞬间完成升级并自动重新运行。&#x0a;您的所有个性化设置与便携数据均完好保留。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               LineHeight="18"
                               Margin="0,0,0,16" />

                    <!-- Restart Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MacOsEmeraldButtonStyle}"
                                Content="立即重启并完成更新"
                                Padding="18,0"
                                Margin="0,0,10,0"
                                Click="OnRestartAndInstallClick" />
                        <Button Style="{StaticResource MacOsPillButtonStyle}"
                                Content="稍后手动重启"
                                Click="OnCloseButtonClick" />
                    </StackPanel>
                </StackPanel>

                <!-- 6. Error View -->
                <StackPanel x:Name="ErrorView" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#18F59E0B"
                            BorderBrush="#35F59E0B"
                            BorderThickness="1.5"
                            HorizontalAlignment="Center">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                     Glyph="&#xE7BA;"
                                     FontSize="22"
                                     Foreground="#F59E0B"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="检查更新失败"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4" />
                    <TextBlock Text="无法连接到更新服务器，请检查网络连接后重试。"
                               FontSize="12"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                    <TextBlock x:Name="ErrorMessageText"
                               Text="网络连接超时"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                               Margin="0,6,0,16" />

                    <!-- Error Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                Content="重试"
                                Width="100"
                                Margin="0,0,10,0"
                                Click="OnRetryClick" />
                        <Button Style="{StaticResource MacOsPillButtonStyle}"
                                Content="好"
                                Width="80"
                                Click="OnCloseButtonClick" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
