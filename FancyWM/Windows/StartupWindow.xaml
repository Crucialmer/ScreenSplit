<Window x:Class="FancyWM.Windows.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:FancyWM"
        xmlns:res="clr-namespace:FancyWM.Resources"
        xmlns:viewmodels="clr-namespace:FancyWM.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
        mc:Ignorable="d"
        Title="ScreenSplit 启动提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="660"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif"
        Foreground="{DynamicResource LiquidGlassPrimaryFg}"
        ui:ThemeManager.IsThemeAware="True"
        MouseLeftButtonDown="OnWindowMouseDown">

    <!-- macOS 26 Liquid Glass Floating Sheet -->
    <Border x:Name="SheetContainer"
            Margin="26"
            CornerRadius="22"
            Background="{DynamicResource LiquidGlassWindowBg}"
            BorderBrush="{DynamicResource LiquidGlassWindowBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SheetTranslate" Y="12" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="10" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <Grid>
            <!-- Top Liquid Glass Specular Refraction Sheen -->
            <Border CornerRadius="21,21,10,10"
                    VerticalAlignment="Top"
                    Height="48"
                    Margin="0.5,0.5,0.5,0"
                    Background="{DynamicResource LiquidGlassTopSheen}"
                    IsHitTestVisible="False" />

            <DockPanel LastChildFill="True">
                <!-- macOS 26 Frameless Title Bar with Group-Hover Traffic Lights -->
                <Border DockPanel.Dock="Top"
                        Height="44"
                        Padding="18,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource LiquidGlassSeparator}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid>
                        <StackPanel x:Name="TrafficLightsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Background="Transparent">
                            <!-- Red (Close) -->
                            <Button Click="OnCloseButtonClick"
                                    Width="12" Height="12"
                                    Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="关闭窗口">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" Width="12" Height="12" CornerRadius="6" Background="#FF5F56" BorderBrush="#D9453E" BorderThickness="0.5">
                                            <TextBlock x:Name="Glyph" Text="×" FontSize="9.5" FontWeight="Bold" Foreground="#5A0000" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter TargetName="Dot" Property="Background" Value="#488E8E93" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#308E8E93" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TrafficLightsPanel}" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="#FF5F56" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#D9453E" />
                                                <Setter TargetName="Glyph" Property="Opacity" Value="0.88" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Yellow (Minimize) -->
                            <Button Click="OnMinimizeButtonClick"
                                    Width="12" Height="12"
                                    Padding="0" Margin="0,0,8,0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="最小化">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Dot" Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderBrush="#D99B1C" BorderThickness="0.5">
                                            <TextBlock x:Name="Glyph" Text="−" FontSize="9.5" FontWeight="Bold" Foreground="#5C3B00" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter TargetName="Dot" Property="Background" Value="#488E8E93" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#308E8E93" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=TrafficLightsPanel}" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="#FFBD2E" />
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="#D99B1C" />
                                                <Setter TargetName="Glyph" Property="Opacity" Value="0.88" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Green (Disabled in fixed sheet) -->
                            <Border Width="12" Height="12" CornerRadius="6" Background="#488E8E93" BorderBrush="#308E8E93" BorderThickness="0.5" />
                        </StackPanel>

                        <TextBlock Text="欢迎使用 ScreenSplit"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <StackPanel Margin="24,18,24,22" Orientation="Vertical">
                    <!-- Hero Identity Glass Card -->
                    <Border Background="{DynamicResource LiquidGlassCardBg}"
                            BorderBrush="{DynamicResource LiquidGlassCardBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="18,14"
                            Margin="0,0,0,16">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    Width="50" Height="50"
                                    CornerRadius="12"
                                    Margin="0,0,15,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.24" Color="#000000" />
                                </Border.Effect>
                                <Image x:Name="AppHeroIcon" Width="50" Height="50" Stretch="Uniform" />
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ScreenSplit"
                                               FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                                               FontWeight="SemiBold"
                                               FontSize="18.5"
                                               Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <Border Background="{DynamicResource LiquidGlassAccentTintBg}"
                                            BorderBrush="{DynamicResource LiquidGlassAccentTintBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,1.5"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static local:App.StartupBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource LiquidGlassAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="软件已就绪并常驻右下角系统托盘 · 纯鼠标直觉交互 · 240Hz 超流畅"
                                           FontSize="12"
                                           Foreground="{DynamicResource LiquidGlassSecondaryFg}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- macOS 26 Inset Grouped Feature Container -->
                    <Border Style="{StaticResource MacGroupedCardStyle}">
                        <StackPanel Orientation="Vertical">
                            <!-- Feature 1: Four Edges Snap -->
                            <DockPanel LastChildFill="True" Margin="16,12">
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="#007AFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE737;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="四周边缘智能停靠（二分之一分屏）" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <TextBlock Text="按住标题栏拖拽窗口至屏幕左、右、上、下任意物理边缘，松开即刻精准占用对应半屏。" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Rectangle Style="{StaticResource MacHairlineDividerStyle}" />

                            <!-- Feature 2: Four Corners Snap -->
                            <DockPanel LastChildFill="True" Margin="16,12">
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="#34C759" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE784;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="四个顶角精细停靠（四分之一分屏）" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <TextBlock Text="拖拽窗口至屏幕左上、右上、左下、右下任意最顶点，松开自动精准停靠四分之一屏幕。" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Rectangle Style="{StaticResource MacHairlineDividerStyle}" />

                            <!-- Feature 3: Drag away to restore -->
                            <DockPanel LastChildFill="True" Margin="16,12">
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="#FF9500" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE777;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="拖离边缘绝对锚定与原始尺寸记忆" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <TextBlock Text="从边缘拖出至自由空间松开，窗口在落点零跳动平滑恢复停靠前的原始尺寸与纵横比。" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <Rectangle Style="{StaticResource MacHairlineDividerStyle}" />

                            <!-- Feature 4: Free Floating & Multi-Monitor -->
                            <DockPanel LastChildFill="True" Margin="16,12">
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="#AF52DE" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C9;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="纯绿色便携与多显示器原生适配" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LiquidGlassPrimaryFg}" />
                                    <TextBlock Text="零注册表污染、配置随目录收纳；完美支持多显示器独立吸附与 240Hz 电竞级流畅响应。" FontSize="11.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Actions Bar -->
                    <DockPanel LastChildFill="False" Margin="2,18,2,0">
                        <CheckBox DockPanel.Dock="Left"
                                  IsChecked="{Binding Path=ShowStartupWindow, Mode=TwoWay}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="启动时显示此引导提示" FontSize="12.5" Foreground="{DynamicResource LiquidGlassSecondaryFg}" />
                        </CheckBox>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MacOsPillButtonStyle}"
                                    Click="OnHelpClick"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE897;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource LiquidGlassSecondaryFg}" />
                                    <TextBlock Text="详细指南" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MacOsPrimaryButtonStyle}"
                                    Click="OnStartExperienceClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="开始使用" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
