<Window x:Class="FancyWM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="ScreenSplitMainWindow"
        xmlns:res="clr-namespace:FancyWM.Resources"
        WindowStyle="None"
        Focusable="True"
        ShowInTaskbar="False"
        WindowState="Minimized">
    <Window.Resources>
        <ContextMenu x:Key="NotifierContextMenu" Placement="MousePoint">
            <MenuItem Header="ScreenSplit  v2.19.1" IsEnabled="False" FontWeight="SemiBold" />
            <MenuItem Header="纯绿色便携 · 边缘智能吸附分屏" IsEnabled="False" FontSize="11" Margin="0,-3,0,0" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Settings}" Click="OnSettingsClick">
                <MenuItem.Icon>
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="13" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="检查更新..." Click="OnCheckUpdatesClick">
                <MenuItem.Icon>
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE895;" FontSize="13" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="恢复系统原生贴靠 (Aero Snap)" Click="OnRestoreSystemSnapClick">
                <MenuItem.Icon>
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE737;" FontSize="13" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static res:Strings.Quit}" Click="OnExitClick">
                <MenuItem.Icon>
                    <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="13" Foreground="#FF3B30" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
</Window>
